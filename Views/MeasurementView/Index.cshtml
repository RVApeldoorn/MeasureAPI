@model IEnumerable<MeasurementApi.Models.Measurement>

<h1>All Measurements</h1>
<table border="1">
    <thead>
        <tr>
            <th>ID</th>
            <th>Patient ID</th>
            <th>Height</th>
            <th>Weight</th>
            <th>Created at</th>
            <th>Updated at</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var m in Model)
    {
        <tr style="cursor: pointer;" onclick="window.location='/measurements/@m.Id'">
            <td>@m.Id</td>
            <td>@m.PatientId</td>
            <td>@m.Height @m.HeightUnit</td>
            <td>@m.Weight @m.WeightUnit</td>
            <td>@m.CreatedAt</td>
            <td>@m.UpdatedAt</td>
        </tr>
    }
    </tbody>
</table>

<style>
    tbody tr:hover {
        background-color: #73a5f4;
    }
</style>
