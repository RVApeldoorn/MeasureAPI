# Get all patients
GET http://localhost:5005/api/user/allpatients
Content-Type: application/json

###

# Create a new measurement session
POST http://localhost:5005/api/user/createmeasurementsession
Content-Type: application/json

{
  "CreatedByUserId": 1,
  "PatientId": "patient_1",
  "dueDate": "2025-06-01",
  "requests": [
    {
      "measurementTypeId": 1
    },
    {
      "measurementTypeId": 2
    }
  ]
}

###

# Fetch measurement sessions for a patient
GET http://localhost:5005/api/patient/sessions
Authorization: Bearer ...
Content-Type: application/json

###

# Submit measurements
POST http://localhost:5005/api/patient/submit
Authorization: Bearer ...
Content-Type: application/json

{
  "sessionId": 1,
  "values": [
    {
      "measurementRequestId": 1,
      "value": "123",
      "note": "Bla bla bla"
    },
    {
      "measurementRequestId": 2,
      "value": "45",
      "note": "Bla bla bla"
    }
  ]
}

###

# Setup Patient (Get JWT Token)
POST http://localhost:5005/api/auth/setup
Content-Type: application/json

{
  "setupCode": "ABC123"
}

